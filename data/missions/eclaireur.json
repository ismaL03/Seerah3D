 "sequence": [
  {
   "type": "scene",
   "scene": "hudaybiya",
   "titre": "Al-Hudaybiya",
   "sous": "Dhû al-Qa'da, an 6 de l'Hégire"
  },
  {
   "type": "recit",
   "texte": "On annonce à Quraysh que les gens de Médine approchent, nombreux, et campent à al-Hudaybiya, aux limites du territoire sacré. Viennent-ils faire la guerre ? Votre chef, allié de Quraysh, vous envoie voir de vos yeux avant de décider."
  },
  {
   "type": "objectif",
   "texte": "Montez sur la colline, au nord, pour observer le camp de loin.",
   "cible": "zone:colline",
   "quand": {
    "zone": "colline"
   }
  },
  {
   "type": "faire",
   "actions": [
    {
     "regarder": [
      60,
      2,
      -100
     ],
     "duree": 1.4
    }
   ]
  },
  {
   "type": "recit",
   "texte": "D'en haut, vous voyez le camp : des tentes, et des hommes vêtus de deux simples pièces de tissu blanc, sans armure. Une rumeur monte jusqu'à vous : « Labbayka Allâhumma labbayk… » Dans le lit du wadi, des chamelles sont rassemblées."
  },
  {
   "type": "objectif",
   "texte": "Descendez voir de plus près les chamelles rassemblées dans le wadi.",
   "cible": "zone:wadi",
   "quand": {
    "zone": "wadi"
   }
  },
  {
   "type": "faire",
   "actions": [
    {
     "regarder": [
      30,
      1.8,
      -66
     ],
     "duree": 1
    }
   ]
  },
  {
   "type": "recit",
   "texte": "Ces bêtes portent des colliers au cou et une entaille à la bosse : ce sont des offrandes destinées au sacrifice, à La Mecque. Chez les Arabes, on ne touche pas à de tels animaux. Ceux qui les mènent viennent en pèlerins."
  },
  {
   "type": "objectif",
   "texte": "Retournez au conseil de Quraysh, au sud, pour rendre compte de ce que vous avez vu.",
   "cible": "zone:conseil",
   "quand": {
    "zone": "conseil"
   }
  },
  {
   "type": "parole",
   "qui": "chef",
   "texte": "Alors, l'éclaireur ? Qu'as-tu vu ? Une armée qui vient nous prendre la ville ?"
  },
  {
   "type": "choix",
   "qui": "chef",
   "question": "Que rapportez-vous au conseil ?",
   "options": [
    {
     "texte": "« Ils viennent en pèlerins, avec des bêtes de sacrifice parées. On n'écarte pas de la Maison ceux qui viennent l'honorer. »",
     "juste": true
    },
    {
     "texte": "« Une armée, sans aucun doute : ils sont très nombreux. Attaquons-les avant qu'ils ne soient à nos portes. »",
     "suite": [
      {
       "type": "parole",
       "qui": "chef",
       "texte": "Je le savais ! Qu'on prépare les chevaux et les armes."
      },
      {
       "type": "recit",
       "texte": "Les hommes courent aux armes. Au mois sacré, à deux pas du territoire sacré, le sang va couler…"
      }
     ],
     "titre": "Le faux rapport",
     "consequence": "Et si l'éclaireur avait menti : Quraysh aurait attaqué des pèlerins au mois sacré. Selon Ibn Ishâq, le chef des Ahâbîsh, al-Hulays, vit les bêtes du sacrifice et revint dire à Quraysh qu'on ne pouvait pas écarter de la Maison ceux qui venaient l'honorer.",
     "indice": "Chez les Arabes, on n'écartait pas de la Maison ceux qui venaient l'honorer avec leurs bêtes de sacrifice."
    },
    {
     "texte": "« Je n'ai pas bien vu : il faisait trop chaud, et c'était trop loin. Décidez sans moi, je ne veux pas d'histoires. »",
     "suite": [
      {
       "type": "parole",
       "qui": "chef",
       "texte": "À quoi sert un éclaireur qui n'a rien vu ? Nous déciderons donc seuls : ils n'entreront pas."
      }
     ],
     "titre": "Le témoin qui se tait",
     "consequence": "Et si l'éclaireur s'était dérobé : faute de témoin, la méfiance l'aurait emporté. Selon Ibn Ishâq, al-Hulays rapporta au contraire fidèlement ce qu'il avait vu, et prit la défense des pèlerins.",
     "indice": "Chez les Arabes, on n'écartait pas de la Maison ceux qui venaient l'honorer avec leurs bêtes de sacrifice."
    }
   ]
  },
  {
   "type": "parole",
   "qui": "chef",
   "texte": "Assieds-toi ! Tu n'es qu'un Bédouin : tu n'y connais rien."
  },
  {
   "type": "choix",
   "qui": "chef",
   "question": "Le chef vous méprise devant tous. Que répondez-vous ?",
   "options": [
    {
     "texte": "« Ce n'est pas pour cela que nous nous sommes alliés à vous : laissez-les accomplir ce pour quoi ils sont venus. »",
     "juste": true
    },
    {
     "texte": "« Tu as raison, je ne suis qu'un Bédouin : faites comme vous l'entendez, ce n'est pas mon affaire. »",
     "suite": [
      {
       "type": "recit",
       "texte": "Vous vous rasseyez en silence. Le conseil décide de barrer la route aux pèlerins, par la force s'il le faut."
      }
     ],
     "titre": "La vérité abandonnée",
     "consequence": "Et si les alliés de Quraysh s'étaient tus : la voix de la raison aurait manqué ce jour-là. Selon Ibn Ishâq, al-Hulays menaça au contraire de se retirer avec tous les Ahâbîsh si l'on empêchait les pèlerins d'honorer la Maison.",
     "indice": "Dire la vérité, c'est aussi la défendre quand on la conteste."
    },
    {
     "texte": "Tirer votre épée : on n'insulte pas un homme des Ahâbîsh impunément, chef de Quraysh ou pas.",
     "suite": [
      {
       "type": "faire",
       "actions": [
        {
         "geste": "chef2"
        },
        {
         "aller": "chef2",
         "vers": "joueur",
         "vitesse": 2.5
        }
       ]
      },
      {
       "type": "parole",
       "qui": "chef2",
       "texte": "Une épée tirée sous la tente du conseil ? Qu'on le désarme !"
      }
     ],
     "titre": "L'épée tirée",
     "consequence": "Et si l'éclaireur avait répondu par l'épée : une querelle entre alliés aurait éclaté, au lieu de faire entendre la vérité. Selon Ibn Ishâq, al-Hulays répondit par des paroles fermes, sans violence.",
