 "sequence": [
  {
   "type": "scene",
   "scene": "makka",
   "titre": "La Mecque",
   "sous": "20 Ramadân, an 8 de l'Hégire (janvier 630)"
  },
  {
   "type": "recit",
   "texte": "Cette nuit, dix mille feux brillaient sur les hauteurs de Marr az-Zahrân. Au matin, une armée immense s'avance vers La Mecque par plusieurs côtés à la fois. Dans les rues, c'est la panique : on court, on crie, on barricade les portes."
  },
  {
   "type": "faire",
   "actions": [
    {
     "aller": "crieur",
     "vers": "joueur",
     "vitesse": 2
    }
   ]
  },
  {
   "type": "parole",
   "qui": "crieur",
   "texte": "Écoutez, gens de La Mecque ! Celui qui entre dans la maison d'Abû Sufyân est en sécurité. Celui qui dépose les armes est en sécurité. Celui qui ferme sa porte sur lui est en sécurité !"
  },
  {
   "type": "faire",
   "actions": [
    {
     "aller": "crieur",
     "vers": [
      [
       -20,
       60
      ],
      [
       0,
       140
      ]
     ],
     "vitesse": 2,
     "attendre": false
    }
   ]
  },
  {
   "type": "objectif",
   "texte": "Votre voisine et ses enfants sont dans la rue, affolés. Allez lui parler.",
   "cible": "pnj:voisine",
   "quand": {
    "parler": "voisine"
   }
  },
  {
   "type": "parole",
   "qui": "voisine",
   "texte": "Que va-t-il nous arriver ? Mon mari est parti avec les hommes armés, vers al-Khandama. Il dit qu'ils barreront la route à l'armée…"
  },
  {
   "type": "choix",
   "qui": "voisine",
   "question": "Que lui conseillez-vous ?",
   "options": [
    {
     "texte": "« Rentre chez toi avec les enfants et ferme ta porte : le crieur a promis la sécurité à qui reste chez soi. »",
     "juste": true
    },
    {
     "texte": "« Viens, allons rejoindre les hommes à al-Khandama : à plusieurs, nous pourrons leur barrer la route. »",
     "suite": [
      {
       "type": "faire",
       "actions": [
        {
         "suivre": "voisine",
         "ecart": 2.2
        },
        {
         "suivre": "enfant1",
         "ecart": 3
        },
        {
         "suivre": "enfant2",
         "ecart": 3.4
        }
       ]
      },
      {
       "type": "objectif",
       "texte": "Conduisez-les vers la colline d'al-Khandama, au sud.",
       "cible": "zone:khandama",
       "quand": {
        "zone": "khandama"
       }
      },
      {
       "type": "recit",
       "texte": "Sur la colline, quelques dizaines d'hommes attendent, l'arme au poing. Une colonne approche. Quelques flèches partent… puis c'est la débandade, et des hommes tombent."
      }
     ],
     "titre": "Al-Khandama",
     "consequence": "Et si vous les aviez menés au combat : à al-Khandama, une poignée d'hommes de Quraysh affronta la colonne de Khâlid ibn al-Walîd, et une douzaine y perdirent la vie. Partout ailleurs, la ville fut prise sans combat.",
     "indice": "La sécurité était promise à ceux qui restaient chez eux, portes closes, ou entraient dans la Mosquée sacrée."
    },
    {
     "texte": "« Partons nous cacher dans la montagne, comme nos pères au temps de l'Éléphant, jusqu'à ce que tout soit fini. »",
     "suite": [
      {
       "type": "faire",
       "actions": [
        {
         "suivre": "voisine",
         "ecart": 2.2
        },
        {
         "suivre": "enfant1",
         "ecart": 3
        },
        {
         "suivre": "enfant2",
         "ecart": 3.4
        }
       ]
      },
      {
       "type": "objectif",
       "texte": "Emmenez-les vers la montagne, à l'ouest de la ville.",
       "cible": "zone:montagne",
       "quand": {
        "zone": "montagne"
       }
      },
      {
       "type": "recit",
       "texte": "Sur les pentes, sous le soleil, les enfants ont soif : vous n'avez emporté ni eau ni vivres. En bas, la ville est étrangement calme."
      }
     ],
     "titre": "La fuite",
     "consequence": "Et si vous aviez fui : des familles entières se seraient jetées sur les pentes sans eau ni abri, alors que la sécurité était promise à ceux qui restaient chez eux. Ce jour-là, La Mecque ne fut pas livrée au pillage.",
     "indice": "La sécurité était promise à ceux qui restaient chez eux, portes closes, ou entraient dans la Mosquée sacrée."
    }
   ]
  },
  {
   "type": "faire",
   "actions": [
