   "qualite": "dans les rues de La Mecque"
  },
  "voisine": {
   "nom": "Votre voisine",
   "qualite": ""
  },
  "affoles": {
   "nom": "Un Mecquois",
   "qualite": "dans la rue"
  },
  "armes": {
   "nom": "Un homme armé",
   "qualite": "à al-Khandama"
  }
 },
 "dialogues": {
  "affoles": [
   "Dix mille hommes ! On dit qu'ils entrent par quatre côtés à la fois.",
   "Abû Sufyân est revenu de leur camp : il dit qu'il ne faut pas combattre, que ceux qui restent chez eux seront épargnés.",
   "Moi, je ferme ma porte et je n'en sors plus."
  ],
  "armes": [
   "Nous ne laisserons pas entrer cette armée sans combattre !"
  ]
 },
