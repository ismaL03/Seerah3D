 "sequence": [
  {
   "type": "scene",
   "scene": "port",
   "titre": "Shu'ayba, sur la mer Rouge",
   "sous": "Rajab, an 5 de la mission (vers 615)"
  },
  {
   "type": "recit",
   "texte": "Le petit port de Shu'ayba, sur la côte de la mer Rouge. Deux navires marchands s'apprêtent à partir pour l'Abyssinie. À l'aube, des voyageurs venus de La Mecque vous ont demandé passage : une quinzaine d'hommes et de femmes qui fuient les persécutions de Quraysh."
  },
  {
   "type": "objectif",
   "texte": "Allez voir votre marin, près du navire.",
   "cible": "pnj:marin",
   "quand": {
    "parler": "marin"
   }
  },
  {
   "type": "parole",
   "qui": "marin",
   "texte": "Patron, ils ont payé un demi-dinar chacun. Ils sont à bord, sous la toile. Ils ont l'air pressés : on dirait qu'ils craignent d'être suivis. Il ne manque plus que l'eau douce pour la traversée."
  },
  {
   "type": "objectif",
   "texte": "Prenez l'outre d'eau douce, près des jarres.",
   "cible": "objet:outre",
   "quand": {
    "prendre": "outre",
    "porter": "outre"
   }
  },
  {
   "type": "objectif",
   "texte": "Portez-la jusqu'au navire, sur la grève.",
   "cible": "zone:greve",
   "quand": {
    "zone": "greve"
   }
  },
  {
   "type": "faire",
   "actions": [
    {
     "porter": null
    },
    {
     "montrer": [
      "chef",
      "poursuivants",
      "cheval1",
      "cheval2"
     ]
    },
    {
     "regarder": [
      60,
      1.6,
      6
     ],
     "duree": 1
    },
    {
     "aller": "poursuivants",
     "vers": [
      [
       -2,
       10
      ]
     ],
     "vitesse": 3.2,
     "attendre": false
    },
    {
     "aller": "cheval1",
     "vers": [
      [
       2,
       14
      ]
     ],
     "vitesse": 3.2,
     "attendre": false
    },
    {
     "aller": "cheval2",
     "vers": [
      [
       3,
       8
      ]
     ],
     "vitesse": 3.2,
     "attendre": false
    },
    {
     "aller": "chef",
     "vers": "joueur",
     "vitesse": 3.2
    }
   ]
  },
  {
   "type": "parole",
   "qui": "chef",
   "texte": "Hé, toi ! Des gens de La Mecque sont-ils passés par ici ? Des fuyards, qui ont abandonné leurs clans. Dis-nous où ils sont, et tu seras bien payé."
  },
  {
   "type": "choix",
   "qui": "chef",
   "question": "Que répondez-vous ?",
   "options": [
    {
     "texte": "« Ceux qui montent sur mon navire ont payé leur passage et se sont confiés à moi. Je ne livre personne. »",
     "juste": true,
     "suite": [
      {
       "type": "parole",
       "qui": "chef",
       "texte": "Nous les trouverons bien, avec ou sans toi ! Fouillez la côte vers le sud !"
      },
      {
       "type": "faire",
       "actions": [
        {
         "aller": "poursuivants",
         "vers": [
          [
           10,
           60
          ],
          [
           20,
           140
          ]
         ],
         "vitesse": 2.6,
         "attendre": false
        },
        {
         "aller": "chef",
         "vers": [
          [
           12,
           60
          ],
          [
           22,
           140
          ]
         ],
         "vitesse": 2.6,
         "attendre": false
        },
        {
         "aller": "cheval1",
         "vers": [
          [
           14,
           60
          ],
          [
           24,
           140
          ]
         ],
         "vitesse": 2.6,
         "attendre": false
        },
        {
         "aller": "cheval2",
         "vers": [
          [
           16,
           60
          ],
          [
           26,
           140
          ]
         ],
         "vitesse": 2.6,
         "attendre": false
        }
       ]
      }
     ]
    },
    {
     "texte": "Prendre la récompense, et désigner d'un signe de tête la toile sous laquelle se cachent les voyageurs.",
     "suite": [
      {
       "type": "faire",
       "actions": [
        {
         "aller": "poursuivants",
         "vers": [
          [
           -17,
           2
          ]
         ],
         "vitesse": 3.2
        }
       ]
      },
      {
       "type": "parole",
       "qui": "chef",
       "texte": "Les voilà ! Faites-les descendre, ils rentrent à La Mecque avec nous !"
      }
     ],
     "titre": "Le passeur a vendu ses passagers",
     "consequence": "Et si le passeur les avait livrés : ramenés de force à La Mecque, ils auraient subi de nouveau la persécution. L'histoire fut autre : selon Ibn Sa'd, les hommes de Quraysh arrivèrent au rivage quand les navires avaient déjà pris la mer.",
     "indice": "Un marin honnête ne livre pas ceux qui se sont confiés à lui."
    },
    {
     "texte": "Faire monter les enchères : « Combien, pour ce renseignement ? » et attendre de voir qui paiera le plus.",
     "suite": [
      {
       "type": "parole",
       "qui": "chef",
       "texte": "Tu marchandes ? C'est donc que tu sais quelque chose. Fouillez ce navire !"
      },
      {
       "type": "faire",
       "actions": [
        {
         "aller": "poursuivants",
         "vers": [
          [
           -17,
           2
          ]
         ],
         "vitesse": 3.2
        }
       ]
      }
     ],
     "titre": "L'hésitation qui trahit",
     "consequence": "Et si le passeur avait marchandé : son hésitation l'aurait trahi, et les voyageurs auraient été découverts. Selon Ibn Sa'd, ils partirent au contraire sans être rattrapés : Quraysh arriva trop tard.",
     "indice": "Un marin honnête ne livre pas ceux qui se sont confiés à lui."
    }
   ]
  },
  {
   "type": "faire",
   "actions": [
    {
     "inviter": "bord",
     "texte": "Monter à bord"
    }
   ]
  },
  {
   "type": "objectif",
   "texte": "Montez à bord et larguez les amarres.",
   "cible": "lieu:bord",
   "quand": {
    "utiliser": "bord"
   }
  },
  {
   "type": "faire",
   "actions": [
    {
     "inviter": "bord",
     "texte": null
    },
    {
     "cacher": "navire"
    },
    {
     "teleporter": [
      -31.5,
      0,
      270
     ]
    },
    {
     "bateau": true,
     "vitesse": 7
    }
   ]
  },
  {
   "type": "recit",
   "texte": "Vous tenez la barre. Z pour gonfler la voile, S pour ralentir, Q et D pour tourner. Les récifs affleurent : l'écume blanche les trahit. Gardez le chenal d'eau sombre."
  },
  {
   "type": "objectif",
   "epreuve": true,
   "texte": "Sortez vers le large, à l'ouest, sans heurter les récifs.",
   "cible": "zone:large",
   "quand": {
    "zone": "large"
   },
   "reussite": "Au large !",
   "echecs": [
    {
     "recif": true,
     "titre": "Le récif",
     "consequence": "Et si le navire avait heurté un récif : coque ouverte, passagers à l'eau, et les poursuivants sur la grève. Les marins de la mer Rouge connaissaient ses récifs ; ce jour-là, les deux navires passèrent.",
     "indice": "Ralentissez (S) avant les passages étroits et visez l'eau sombre, entre les écumes."
    }
   ]
  },
  {
   "type": "recit",
   "texte": "Les voiles se gonflent. Sur la grève, les hommes de Quraysh accourent, trop tard. Selon Ibn Sa'd, ils arrivèrent au rivage quand les navires étaient déjà partis."
  },
  {
   "type": "recit",
   "texte": "Ce furent les premiers émigrés de l'islam. En Abyssinie, auprès du Négus, un roi chrétien réputé pour sa justice, ils trouvèrent la sécurité qu'on leur refusait à La Mecque."
  }
 ],
 "fin": "Cap sur l'Abyssinie"
