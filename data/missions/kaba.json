  }
 ],
 "role": {
  "nom": "Un homme de Quraysh",
  "nom_ar": "رجل من قريش",
  "texte": "Vous êtes un Mecquois parmi d'autres, membre d'un des clans qui gardent la Maison. La Ka'ba doit être rebâtie : à vous d'y apporter votre part, et de garder la tête froide quand les clans s'affronteront.",
  "regle": "Le Prophète ﷺ n'est jamais montré : une lumière marque sa présence, et seules les paroles rapportées par les sources lui sont attribuées. Les mauvais choix mènent à des scénarios imaginaires, présentés comme tels."
 },
 "personnages": {
  "walid": {
   "nom": "al-Walîd ibn al-Mughîra",
   "qualite": "notable de Quraysh"
  },
  "ancien": {
   "nom": "Le plus âgé de Quraysh",
   "qualite": "Abû Umayya ibn al-Mughîra, selon Ibn Ishâq"
  },
  "preteur": {
   "nom": "Un prêteur",
   "qualite": "marché de La Mecque"
  },
  "tanneur": {
   "nom": "Un marchand de cuir",
   "qualite": "marché de La Mecque"
  },
  "fort": {
   "nom": "Un homme puissant",
   "qualite": "marché de La Mecque"
  },
  "clan1": {
   "nom": "Un homme des Banû 'Abd ad-Dâr",
   "qualite": "Quraysh"
  },
  "passants": {
   "nom": "Un Mecquois",
   "qualite": "passant"
  }
 },
 "dialogues": {
  "preteur": [
   "Je prête aux pèlerins et aux marchands : pour dix pièces prêtées, on m'en rend vingt à la saison suivante. Mon argent est à ta disposition pour la Maison !"
  ],
  "tanneur": [
   "Je tanne des peaux et je les vends au juste prix, à la foire de 'Ukâz. Ce n'est pas une fortune, mais elle est honnête. Prends-en une part pour la Maison, si tu veux."
  ],
  "fort": [
   "Mon voisin était trop faible pour garder sa récolte : je l'ai prise. Qui viendrait me la réclamer ? Prends cet or pour la Maison, il y en a bien assez."
  ],
  "passants": [
   "On dit qu'un navire des Rûm s'est échoué sur la côte, à Shu'ayba : son bois servira pour le toit de la Ka'ba.",
   "Al-Walîd a donné le premier coup de pioche. S'il est encore vivant demain matin, c'est que la Maison accepte qu'on la rebâtisse.",
   "Chaque clan a reçu une partie des murs à construire. Gare à qui voudra la part d'un autre !"
  ]
 },
