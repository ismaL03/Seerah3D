 "sequence": [
  {
   "type": "scene",
   "scene": "miqat",
   "titre": "Dhû al-Hulayfa",
   "sous": "Le mîqât des gens de Médine, aujourd'hui"
  },
  {
   "type": "recit",
   "texte": "Vous voici à Dhû al-Hulayfa, à quelques kilomètres de Médine. C'est l'un des mîqât fixés par le Prophète ﷺ, les lieux où l'on entre en état de sacralisation, l'ihrâm, avant de gagner La Mecque. C'est d'ici qu'il ﷺ partit pour son pèlerinage d'adieu."
  },
  {
   "type": "objectif",
   "texte": "Prenez les deux pièces de tissu blanc de l'ihrâm, posées sur le banc.",
   "cible": "objet:ihram",
   "quand": {
    "prendre": "ihram"
   }
  },
  {
   "type": "choix",
   "question": "Comment vous préparez-vous à entrer en ihrâm ?",
   "options": [
    {
     "texte": "Faire le grand lavage, puis revêtir le pagne et le drap blancs, sans vêtement cousu ni couvre-chef.",
     "juste": true
    },
    {
     "texte": "Garder la calotte et les chaussettes sous les deux pièces de tissu : le matin est encore frais.",
     "suite": [
      {
       "type": "recit",
       "texte": "Vous voilà prêt, et bien au chaud. Un peu plus loin, un pèlerin âgé vous regarde avec étonnement, puis s'approche."
      },
      {
       "type": "faire",
       "actions": [
        {
         "aller": "ancien",
         "vers": "joueur",
         "vitesse": 1.2
        }
       ]
      },
      {
       "type": "parole",
       "qui": "ancien",
       "texte": "Mon frère, en ihrâm, l'homme garde la tête nue et ne porte ni chaussettes ni vêtement cousu. Sinon, il lui faut une compensation."
      }
     ],
     "titre": "Tête couverte",
     "consequence": "Et si vous étiez entré en ihrâm ainsi : selon le hadith d'Ibn 'Umar, celui qui est en ihrâm ne porte ni chemise, ni turban, ni pantalon, ni burnous, ni chaussons montants. L'erreur se répare, mais la règle est simple : deux pièces de tissu, tête nue.",
     "indice": "Pour l'homme : deux pièces de tissu non cousu, et la tête découverte."
    },
    {
     "texte": "Formuler l'intention d'abord, puis vous parfumer abondamment le corps et les deux tissus.",
     "suite": [
      {
       "type": "faire",
       "actions": [
        {
         "aller": "ancien",
         "vers": "joueur",
         "vitesse": 1.2
        }
       ]
      },
      {
       "type": "parole",
       "qui": "ancien",
       "texte": "Le parfum, c'est avant l'intention, sur le corps. Une fois en ihrâm, on ne se parfume plus."
      }
     ],
     "titre": "Le parfum de trop",
     "consequence": "Et si vous vous étiez parfumé après l'intention : le parfum est permis sur le corps avant l'ihrâm, puis interdit. 'Â'isha rapporte qu'elle parfumait le Prophète ﷺ juste avant son entrée en ihrâm.",
     "indice": "Ce qui est permis avant l'intention ne l'est plus après."
    }
   ]
  },
  {
   "type": "faire",
   "actions": [
    {
     "inviter": "niyya",
     "texte": "Formuler l'intention et dire la talbiya"
    }
   ]
  },
  {
   "type": "objectif",
   "texte": "Devant la mosquée, entrez en ihrâm : formulez l'intention et prononcez la talbiya (maintenez E).",
   "cible": "lieu:niyya",
   "quand": {
    "tenir": "niyya",
    "invocation": {
     "titre": "La talbiya",
     "ar": "لَبَّيْكَ اللَّهُمَّ لَبَّيْكَ، لَبَّيْكَ لَا شَرِيكَ لَكَ لَبَّيْكَ، إِنَّ الْحَمْدَ وَالنِّعْمَةَ لَكَ وَالْمُلْكَ، لَا شَرِيكَ لَكَ",
     "fr": "« Me voici, ô Allah, me voici. Me voici : Tu n'as pas d'associé, me voici. La louange, le bienfait et la royauté sont à Toi ; Tu n'as pas d'associé. »",
     "source": "Talbiya du Prophète ﷺ, Sahîh al-Bukhârî et Sahîh Muslim (hadith d'Ibn 'Umar) · traduction du sens"
    }
   }
  },
  {
   "type": "scene",
   "scene": "arafa",
   "titre": "'Arafa",
   "sous": "9 Dhû al-Hijja"
  },
  {
   "type": "recit",
   "texte": "Le 9 Dhû al-Hijja, tous les pèlerins se retrouvent à 'Arafa, de midi au coucher du soleil. C'est le cœur du pèlerinage : « Le Hajj, c'est 'Arafa », dit le Prophète ﷺ. Mais attention : tout le terrain que vous voyez n'en fait pas partie."
  },
  {
   "type": "objectif",
   "epreuve": true,
   "texte": "Trouvez une place pour l'après-midi et installez-vous sur un tapis (maintenez E). Lisez bien les panneaux verts.",
   "quand": {
    "tenir": "tapisA"
   },
   "reussite": "Vous êtes à 'Arafa",
   "echecs": [
    {
     "tenu": "tapisU",
     "titre": "Hors de 'Arafa",
     "suite": [
      {
       "type": "recit",
       "texte": "Vous voilà bien installé, à l'ombre des acacias du wadi. Les heures passent dans l'invocation… Au coucher du soleil, en vous levant, vous lisez enfin le panneau derrière vous : « Début de 'Arafa »."
      }
     ],
     "consequence": "Et si vous étiez resté dans le wâdî 'Urana : il ne fait pas partie de 'Arafa, et celui qui ne se tient pas à 'Arafa manque le pilier du pèlerinage. Le hadith dit : « Tout 'Arafa est lieu de station, et écartez-vous du fond de 'Urana. »",
     "indice": "Le wadi ombragé, à l'ouest, est hors des limites : franchissez les panneaux « Début de 'Arafa »."
    }
   ]
  },
  {
   "type": "faire",
   "actions": [
    {
     "inviter": "doua",
     "texte": "Invoquer, tourné vers la qibla"
    }
   ]
  },
  {
   "type": "objectif",
   "texte": "Consacrez l'après-midi à l'invocation (maintenez E).",
   "cible": "lieu:doua",
   "guider": false,
   "quand": {
    "tenir": "doua",
    "invocation": {
     "titre": "L'invocation du jour de 'Arafa",
