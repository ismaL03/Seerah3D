 "dialogues": {
  "ancien": [
   "Pour l'homme : deux pièces de tissu non cousu, la tête nue, des sandales. Pour la femme : ses vêtements habituels, amples, sans gants ni voile du visage.",
   "Après l'intention, on répète la talbiya, à voix haute pour les hommes, jusqu'à la lapidation du 10."
  ],
  "pelerins": [
   "Labbayka Allâhumma labbayk !",
   "C'est mon premier Hajj. J'ai attendu ce jour toute ma vie.",
   "Mon guide dit qu'il faut boire beaucoup d'eau : il fait très chaud."
  ],
  "pelerines": [
   "Que la paix soit sur toi. Nous venons d'Indonésie : trois jours de voyage.",
   "Labbayki Allâhumma labbayk."
  ],
  "assis": [
   "Il fait bon à l'ombre de ces arbres… On est bien, ici, non ?"
  ],
  "dormeurs": [
   "Dors un peu, frère : demain sera une longue journée."
  ],
  "lanceurs": [
   "Allâhu akbar !",
   "Un caillou qui n'atteint pas le bassin ne compte pas : il faut en lancer un autre."
  ]
